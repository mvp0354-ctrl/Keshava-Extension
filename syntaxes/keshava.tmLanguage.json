{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Keshava",
  "scopeName": "source.keshava",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.keshava",
          "begin": "\\bTippani\\s*\\{",
          "end": "\\}"
        },
        {
          "name": "comment.line.keshava",
          "match": "\\bTippani\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.keshava",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.keshava",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.keshava",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.keshava",
          "match": "\\b(?:Aarambha|Samaapti|Yadi|Anyathaa|Yaavat|Punah|Viraama|Anuvartaya|Kriyaa|Pratyaagaccha|Aayaat|import)\\b"
        },
        {
          "name": "storage.type.keshava",
          "match": "\\b(?:Sankhya|Paatha|Satyam)\\b"
        },
        {
          "name": "constant.language.boolean.keshava",
          "match": "\\b(?:Satya|Asatya)\\b"
        },
        {
          "name": "keyword.operator.logical.keshava",
          "match": "\\b(?:Aur|Athava|Nahi)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.keshava",
          "match": "\\b(?:Likha|Grahana|append|length|type|int|str|bool|range)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.keshava",
          "match": "==|!=|<=|>=|[+\\-*/%=<>]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.keshava",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
