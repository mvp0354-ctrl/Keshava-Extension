{
  "name": "keshava-language",
  "displayName": "Keshava Language",
  "description": "Syntax highlighting, snippets, file icons, and run commands for Keshava .smp files.",
  "version": "0.1.0",
  "publisher": "keshava",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.com/keshava-language"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "files": [
    "extension.js",
    "language-configuration.json",
    "README.md",
    "LICENSE",
    "icons/**",
    "runtime/**",
    "snippets/**",
    "syntaxes/**"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:keshava",
    "onCommand:keshava.runFile",
    "onCommand:keshava.runFileWithInput"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "keshava",
        "aliases": [
          "Keshava",
          "keshava"
        ],
        "extensions": [
          ".smp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/keshava-file.svg",
          "dark": "./icons/keshava-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "keshava",
        "scopeName": "source.keshava",
        "path": "./syntaxes/keshava.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "keshava",
        "path": "./snippets/keshava.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "keshava.runFile",
        "title": "Keshava: Run Current File"
      },
      {
        "command": "keshava.runFileWithInput",
        "title": "Keshava: Run Current File With Input"
      }
    ],
    "keybindings": [
      {
        "command": "keshava.runFile",
        "key": "f5",
        "when": "editorTextFocus && resourceExtname == .smp"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "keshava.runFile",
          "when": "resourceExtname == .smp",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "keshava.runFile",
          "when": "resourceExtname == .smp",
          "group": "navigation"
        },
        {
          "command": "keshava.runFileWithInput",
          "when": "resourceExtname == .smp",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Keshava",
      "properties": {
        "keshava.pythonPath": {
          "type": "string",
          "default": "auto",
          "description": "Python executable used to run Keshava files. Use auto to detect .venv, py, python3, or python."
        },
        "keshava.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to main.py. Leave empty to use the runtime bundled with this extension."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
